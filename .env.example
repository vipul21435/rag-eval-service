# Copy to .env and adjust. Every variable is optional: the defaults run fully
# locally with no API keys. Real environment variables override .env values.
#
# Settings carry the RAG_ prefix. The third-party credentials OPENAI_API_KEY,
# OPENAI_BASE_URL and SERPAPI_KEY are also read under those conventional
# unprefixed names; the RAG_ name wins when both are set. Values are
# validated on startup: an out-of-range number or an unknown provider name
# stops the server with a message naming the variable.

# --- LLM provider -------------------------------------------------------------
# "ollama" (local server) or "openai" (any OpenAI-compatible Chat Completions
# endpoint). Leave unset to auto-detect: a running Ollama wins, then a
# configured OpenAI API key, otherwise ollama.
#RAG_LLM_PROVIDER=ollama

# Local Ollama server and model (ollama pull llama3.2).
#RAG_OLLAMA_BASE_URL=http://localhost:11434
#RAG_OLLAMA_MODEL=llama3.2

# OpenAI-compatible endpoint: OpenAI, vLLM, LM Studio, hosted providers.
#RAG_OPENAI_API_KEY=
#RAG_OPENAI_BASE_URL=https://api.openai.com/v1
#RAG_OPENAI_MODEL=gpt-4o-mini

# --- Retrieval models (downloaded from the Hugging Face Hub on first use) -----
#RAG_EMBED_MODEL_NAME=all-MiniLM-L6-v2
# cross_encoder | llm | none
#RAG_RERANK_METHOD=cross_encoder
#RAG_RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Retrieval hyperparameters ------------------------------------------------
#RAG_CHUNK_SIZE=400
#RAG_CHUNK_OVERLAP=40
#RAG_HYBRID_ALPHA=0.7
#RAG_RETRIEVAL_TOP_K=10
#RAG_RERANK_TOP_K=5
#RAG_MAX_RETRIEVAL_ITERATIONS=3

# --- Optional web search (SerpAPI) --------------------------------------------
#RAG_SERPAPI_KEY=

# --- HTTP API -----------------------------------------------------------------
# Bind address; the default keeps the unauthenticated API on this machine.
# Set 0.0.0.0 to expose it, and set RAG_API_TOKEN when you do.
#RAG_API_HOST=127.0.0.1
# Unset: the first free port in 17995-17999.
#RAG_API_PORT=17995
# Browser origins allowed to call the API, comma-separated. Empty: no CORS
# headers, so web pages on other origins cannot read responses.
#RAG_CORS_ALLOW_ORIGINS=http://localhost:3000
# Largest document /api/upload accepts, in MB.
#RAG_MAX_UPLOAD_MB=50
# When set, every /api request needs "Authorization: Bearer <token>".
#RAG_API_TOKEN=
